# =====================================================================
# HR Policy RAG Assistant - Environment Configuration
# =====================================================================

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Jina Embeddings API Configuration
# Get your API key from Jina AI: https://jina.ai/embeddings/
JINA_API_KEY=your-jina-api-key-here
JINA_MODEL=jina-embeddings-v2-base-en

# Document & Storage Paths (relative to backend/ or absolute)
HR_POLICY_PATH=data/hr_policy.pdf
CHROMA_PERSIST_DIRECTORY=data/store

# RAG Indexing & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3

# Frontend & CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000
